<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Рабочий Мессенджер с файлами</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
  }
  .screen {
    background: #fff;
    width: 100%;
    max-width: 500px;
    height: 90vh;
    max-height: 720px;
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  .screen.active { display: flex; }

  /* Экран входа */
  .login {
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }
  .login h1 { font-size: 26px; color: #1f2937; text-align: center; margin-bottom: 8px; }
  .login .sub { text-align: center; color: #6b7280; font-size: 14px; margin-bottom: 20px; }
  .login label { font-size: 13px; color: #374151; font-weight: 600; margin-bottom: -10px; }
  .login input {
    padding: 14px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    font-size: 15px;
    outline: none;
    transition: 0.2s;
    width: 100%;
  }
  .login input:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.15); }
  .login .row { display: flex; gap: 10px; }
  .btn {
    padding: 14px;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
    flex: 1;
  }
  .btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(102,126,234,0.4); }
  .btn-secondary { background: #f3f4f6; color: #374151; }
  .btn-secondary:hover { background: #e5e7eb; }
  .btn:active { transform: scale(0.98); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Чат */
  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .header h1 { font-size: 16px; font-weight: 600; }
  .header .room-code {
    font-size: 11px;
    background: rgba(255,255,255,0.2);
    padding: 4px 10px;
    border-radius: 12px;
    font-family: monospace;
    cursor: pointer;
    user-select: all;
  }
  .header .status { font-size: 11px; opacity: 0.9; display: flex; align-items: center; gap: 5px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; }
  .dot.offline { background: #f87171; animation: none; }
  .dot { animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .share-bar {
    padding: 10px 15px;
    background: #f7f8fc;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .share-bar input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 12px;
    background: #fff;
    color: #374151;
  }
  .share-bar button {
    padding: 8px 14px;
    background: #667eea;
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    transition: 0.2s;
    white-space: nowrap;
  }
  .share-bar button:hover { background: #5568d3; }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 15px;
    background: #f7f8fc;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .messages::-webkit-scrollbar { width: 6px; }
  .messages::-webkit-scrollbar-thumb { background: #c7cbd6; border-radius: 3px; }

  .msg {
    max-width: 78%;
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.4;
    word-wrap: break-word;
    animation: appear 0.2s ease-out;
    position: relative;
  }
  @keyframes appear { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  .msg.me {
    align-self: flex-end;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .msg.them {
    align-self: flex-start;
    background: #fff;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 4px;
  }
  .msg .sender { font-size: 11px; font-weight: 700; margin-bottom: 4px; opacity: 0.85; }
  .msg .time { font-size: 10px; opacity: 0.7; margin-top: 4px; text-align: right; }
  .system {
    align-self: center;
    background: rgba(102, 126, 234, 0.1);
    color: #667eea;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 20px;
    text-align: center;
  }

  /* Файлы */
  .msg .file { display: flex; align-items: center; gap: 10px; padding: 6px 0; }
  .msg .file-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(255,255,255,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .msg.them .file-icon { background: #eef2ff; }
  .msg .file-info { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .msg .file-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
  .msg .file-size { font-size: 11px; opacity: 0.75; }
  .msg .file-link { color: inherit; text-decoration: underline; font-size: 12px; opacity: 0.95; margin-top: 2px; display: inline-block; }
  .msg img.preview { max-width: 100%; max-height: 220px; border-radius: 10px; margin-top: 6px; display: block; cursor: pointer; }

  .input-bar {
    padding: 10px 12px;
    background: #fff;
    border-top: 1px solid #e5e7eb;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .input-bar input[type=text] {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    font-size: 14px;
    outline: none;
    transition: 0.2s;
    min-width: 0;
  }
  .input-bar input[type=text]:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.15); }
  .icon-btn {
    width: 44px; height: 44px;
    border: none;
    border-radius: 50%;
    background: #f3f4f6;
    color: #4b5563;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
    flex-shrink: 0;
  }
  .icon-btn:hover { background: #e5e7eb; }
  .send-btn {
    width: 48px; height: 48px;
    border: none;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
    flex-shrink: 0;
  }
  .send-btn:hover { transform: scale(1.05); }
  .send-btn:active { transform: scale(0.95); }
  .send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: #1f2937;
    color: #fff;
    padding: 12px 24px;
    border-radius: 24px;
    font-size: 14px;
    opacity: 0;
    transition: 0.3s;
    pointer-events: none;
    z-index: 1000;
    max-width: 90%;
    text-align: center;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .hint { font-size: 12px; color: #9ca3af; text-align: center; margin-top: 4px; }
</style>
</head>
<body>

<!-- ЭКРАН ВХОДА -->
<div class="screen active" id="loginScreen">
  <div class="login">
    <h1>💬 Мессенджер</h1>
    <p class="sub">Общайтесь и отправляйте файлы через интернет</p>

    <label>Ваше имя</label>
    <input type="text" id="nameInput" placeholder="Например: Алекс" maxlength="20">

    <label>Код комнаты</label>
    <input type="text" id="roomInput" placeholder="Например: 4821" maxlength="20">

    <div class="row">
      <button class="btn btn-secondary" onclick="createRoom()">🎲 Создать</button>
      <button class="btn btn-primary" onclick="joinRoom()">🔗 Войти</button>
    </div>
    <p class="hint">Создайте комнату и передайте код другу</p>
  </div>
</div>

<!-- ЭКРАН ЧАТА -->
<div class="screen" id="chatScreen">
  <div class="header">
    <div>
      <h1 id="roomTitle">Комната</h1>
      <div class="room-code" onclick="copyCode()" id="roomCode">—</div>
    </div>
    <div class="status">
      <span class="dot" id="statusDot"></span>
      <span id="statusText">Подключение...</span>
    </div>
  </div>

  <div class="share-bar">
    <input type="text" id="shareLink" readonly>
    <button onclick="copyLink()">Копировать</button>
  </div>

  <div class="messages" id="messages"></div>

  <div class="input-bar">
    <input type="file" id="fileInput" style="display:none" onchange="onFilePicked(event)">
    <button class="icon-btn" onclick="document.getElementById('fileInput').click()" title="Прикрепить файл">📎</button>
    <input type="text" id="msgInput" placeholder="Сообщение..." maxlength="500">
    <button class="send-btn" id="sendBtn" onclick="sendText()">➤</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- ПОДКЛЮЧАЕМ FIREBASE -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getDatabase, ref, push, onChildAdded } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

// ============================================================
// 1. ВСТАВЬ СЮДА СВОЙ FIREBASE CONFIG
// ============================================================
const firebaseConfig = {
  // ВСТАВЬ СЮДА СВОЙ FIREBASE CONFIG
  apiKey: "ТВОЙ_API_KEY",
  authDomain: "ТВОЙ_PROJECT.firebaseapp.com",
  databaseURL: "https://ТВОЙ_PROJECT-default-rtdb.firebaseio.com",
  projectId: "ТВОЙ_PROJECT",
  storageBucket: "ТВОЙ_PROJECT.appspot.com",
  messagingSenderId: "ТВОЙ_ID",
  appId: "ТВОЙ_APP_ID"
};
// ============================================================

// Инициализация Firebase
const app = initializeApp(firebaseConfig);
const db = getDatabase(app);

let myName = '';
let myId = 'u-' + Math.random().toString(36).slice(2, 8);
let roomCode = '';
let unsubscribe = null;

// ============ Комнаты ============
function createRoom() {
  const name = document.getElementById('nameInput').value.trim();
  if (!name) return showToast('Введите имя');

  roomCode = String(Math.floor(1000 + Math.random() * 9000));
  enterChat(name);
}

function joinRoom() {
  const name = document.getElementById('nameInput').value.trim();
  const code = document.getElementById('roomInput').value.trim();
  if (!name) return showToast('Введите имя');
  if (!code) return showToast('Введите код комнаты');

  roomCode = code;
  enterChat(name);
}

function enterChat(name) {
  myName = name;
  document.getElementById('loginScreen').classList.remove('active');
  document.getElementById('chatScreen').classList.add('active');
  document.getElementById('roomTitle').textContent = '👤 ' + myName;
  document.getElementById('roomCode').textContent = 'Код: ' + roomCode;

  const url = new URL(location.href);
  url.searchParams.set('room', roomCode);
  url.searchParams.set('name', name);
  document.getElementById('shareLink').value = url.toString();

  // Подключаемся к Firebase
  listenToRoom();
  
  // Отправляем системное сообщение
  sendSystemMessage(`👋 ${myName} присоединился к чату`);
  
  setTimeout(() => document.getElementById('msgInput').focus(), 100);
}

function listenToRoom() {
  const messagesRef = ref(db, 'rooms/' + roomCode);

  // Слушаем новые сообщения
  unsubscribe = onChildAdded(messagesRef, (snapshot) => {
    const data = snapshot.val();
    if (!data || data.from === myId) return; // Своё не показываем дважды

    if (data.type === 'system') {
      addSystem(data.text);
    } else if (data.type === 'text') {
      addMessage(data.name, data.text, 'them', data.time);
    } else if (data.type === 'file') {
      addFileMessage(data.name, data.file, 'them', data.time);
    }
  });

  updateStatus(true);
}

function sendSystemMessage(text) {
  const messagesRef = ref(db, 'rooms/' + roomCode);
  push(messagesRef, {
    type: 'system',
    text: text,
    from: myId,
    time: nowTime()
  });
}

// ============ Сообщения ============
function sendText() {
  const input = document.getElementById('msgInput');
  const text = input.value.trim();
  if (!text) return;

  const time = nowTime();
  addMessage(myName, text, 'me', time);

  const messagesRef = ref(db, 'rooms/' + roomCode);
  push(messagesRef, {
    type: 'text',
    text: text,
    from: myId,
    name: myName,
    time: time
  });

  input.value = '';
  input.focus();
}

function addMessage(name, text, who, time) {
  const box = document.getElementById('messages');
  const div = document.createElement('div');
  div.className = 'msg ' + who;
  div.innerHTML = `
    ${who === 'them' ? `<div class="sender">${escapeHtml(name)}</div>` : ''}
    <div>${escapeHtml(text)}</div>
    <div class="time">${time || nowTime()}</div>
  `;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function addSystem(text) {
  const box = document.getElementById('messages');
  const div = document.createElement('div');
  div.className = 'system';
  div.textContent = text;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

// ============ Файлы ============
async function onFilePicked(e) {
  const file = e.target.files[0];
  e.target.value = '';
  if (!file) return;

  if (file.size > 100 * 1024 * 1024) return showToast('Файл больше 100 МБ');

  showToast('⏳ Загрузка файла...');

  try {
    // Загружаем через file.io
    const form = new FormData();
    form.append('file', file);

    const res = await fetch('https://file.io', { method: 'POST', body: form });
    const data = await res.json();

    if (!data.success || !data.link) throw new Error('Ошибка загрузки');

    const fileInfo = {
      name: file.name,
      size: file.size,
      url: data.link,
      isImage: file.type.startsWith('image/')
    };

    const time = nowTime();
    addFileMessage(myName, fileInfo, 'me', time);

    const messagesRef = ref(db, 'rooms/' + roomCode);
    push(messagesRef, {
      type: 'file',
      file: fileInfo,
      from: myId,
      name: myName,
      time: time
    });

    showToast('✅ Файл отправлен');
  } catch (err) {
    console.error(err);
    showToast('❌ Не удалось загрузить файл');
  }
}

function addFileMessage(name, file, who, time) {
  const box = document.getElementById('messages');
  const div = document.createElement('div');
  div.className = 'msg ' + who;

  const sizeStr = formatSize(file.size);
  const imgPreview = file.isImage
    ? `<img class="preview" src="${escapeAttr(file.url)}" alt="" onclick="window.open('${escapeAttr(file.url)}','_blank')">`
    : '';

  div.innerHTML = `
    ${who === 'them' ? `<div class="sender">${escapeHtml(name)}</div>` : ''}
    <div class="file">
      <div class="file-icon">${file.isImage ? '🖼️' : '📄'}</div>
      <div class="file-info">
        <div class="file-name">${escapeHtml(file.name)}</div>
        <div class="file-size">${sizeStr}</div>
        <a class="file-link" href="${escapeAttr(file.url)}" target="_blank" rel="noopener">Скачать</a>
      </div>
    </div>
    ${imgPreview}
    <div class="time">${time || nowTime()}</div>
  `;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function formatSize(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1024 / 1024).toFixed(2) + ' MB';
}

// ============ Утилиты ============
function nowTime() {
  return new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}
function escapeAttr(s) { return escapeHtml(s); }

function copyLink() {
  const input = document.getElementById('shareLink');
  input.select();
  navigator.clipboard.writeText(input.value)
    .then(() => showToast('✅ Ссылка скопирована!'))
    .catch(() => {
      document.execCommand('copy');
      showToast('✅ Ссылка скопирована!');
    });
}

function copyCode() {
  navigator.clipboard.writeText(roomCode)
    .then(() => showToast('✅ Код скопирован: ' + roomCode));
}

function showToast(text) {
  const t = document.getElementById('toast');
  t.textContent = text;
  t.classList.add('show');
  clearTimeout(t._tid);
  t._tid = setTimeout(() => t.classList.remove('show'), 2200);
}

function updateStatus(ok) {
  const dot = document.getElementById('statusDot');
  const txt = document.getElementById('statusText');
  if (ok) {
    dot.classList.remove('offline');
    txt.textContent = 'Онлайн';
  } else {
    dot.classList.add('offline');
    txt.textContent = 'Оффлайн';
  }
}

// ============ Авто-вход по ссылке ============
window.addEventListener('load', () => {
  const params = new URLSearchParams(location.search);
  const r = params.get('room');
  const n = params.get('name');

  if (r) {
    document.getElementById('roomInput').value = r;
    if (n) document.getElementById('nameInput').value = n;
    document.getElementById('nameInput').focus();
    showToast('Введите имя и нажмите «Войти»');
  }
});

// Enter — отправить
document.getElementById('msgInput').addEventListener('keypress', (e) => {
  if (e.key === 'Enter') sendText();
});

// Экспорт функций в глобальную область для кнопок
window.createRoom = createRoom;
window.joinRoom = joinRoom;
window.sendText = sendText;
window.onFilePicked = onFilePicked;
window.copyLink = copyLink;
window.copyCode = copyCode;
</script>
</body>
</html>
